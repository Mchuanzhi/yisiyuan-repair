{
  "description": "壹思源维修报价小程序。用微信开发者工具导入本目录。appid 是占位符 wxXXXXXXXXXXXXXXXX，注册完成后改成你的 AppID，并同步 config.js。",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "scripts" },
      { "type": "suffix", "value": ".md" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "coverView": true,
    "showShadowRootInWxmlPanel": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "compileType": "miniprogram",
  "libVersion": "3.6.5",
  "appid": "wxXXXXXXXXXXXXXXXX",
  "projectname": "yisiyuan-repair",
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
