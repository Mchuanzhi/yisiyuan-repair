<view class="page">
  <view class="topbar">
    <view class="brand">
      <text class="eyebrow">壹思源 · 师傅工作台</text>
      <text class="tagline">透明报价 · 安心维修</text>
    </view>
    <view class="top-actions">
      <picker wx:if="{{cities.length}}" mode="selector" range="{{cities}}" range-key="name" value="{{cityIndex}}" bindchange="onCityChange">
        <view class="city-picker">
          <text class="city-label">城市</text>
          <text class="city-value">{{cityName}}</text>
        </view>
      </picker>
      <text class="mine" bindtap="openAccount">我的</text>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y enhanced="{{false}}" show-scrollbar="{{false}}">
    <view class="status">
      <text class="status-text">{{catalogMessage}}</text>
      <button class="refresh" bindtap="onRefresh">刷新数据</button>
    </view>

    <view class="welcome">
      <view class="welcome-copy">
        <text class="welcome-label">REPAIR & CARE</text>
        <text class="welcome-title">每一份报价</text>
        <text class="welcome-title">都清楚明白</text>
        <text class="welcome-sub">选项目 · 确认费用 · 签名留凭证</text>
      </view>
      <view class="hero">
        <view class="hero-doc">
          <view class="hero-bar hero-bar-short"></view>
          <view class="hero-bar"></view>
          <view class="hero-bar hero-bar-mid"></view>
          <view class="hero-check">✓</view>
        </view>
      </view>
    </view>

    <view class="sheet">
      <view class="search">
        <view class="search-icon"></view>
        <input wx:if="{{searchMounted}}" class="search-input" type="text" confirm-type="search" placeholder="搜索空调漏水、更换电容、马桶维修" bindinput="onSearch" />
      </view>

      <view class="panel">
        <view class="section-toggle" data-key="category" bindtap="togglePanel">
          <text class="section-title">维修品类</text>
          <text class="section-meta">{{categoryCount}}</text>
          <view class="chevron {{collapsed.category ? 'is-collapsed' : ''}}"></view>
        </view>
        <view hidden="{{collapsed.category}}">
          <view class="group-tabs">
            <view wx:for="{{groups}}" wx:key="id" class="group-tab {{item.active ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="onGroup">
              <text class="group-name">{{item.name}}</text>
              <text class="group-count">{{item.count}}</text>
            </view>
          </view>
          <view class="category-grid">
            <view wx:for="{{categories}}" wx:key="id" class="category-card {{item.active ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="onCategory">
              <image class="category-image" src="{{item.image}}" mode="aspectFit" />
              <text class="category-name">{{item.name}}</text>
              <text class="category-count">{{item.count}} 个项目</text>
            </view>
          </view>
        </view>
      </view>

      <view class="panel">
        <view class="section-toggle" data-key="service" bindtap="togglePanel">
          <text class="section-title">{{serviceTitle}}</text>
          <text class="section-meta">{{resultCount}}</text>
          <view class="chevron {{collapsed.service ? 'is-collapsed' : ''}}"></view>
        </view>
        <view hidden="{{collapsed.service}}">
          <view wx:if="{{emptyServices}}" class="empty">{{emptyServices}}</view>
          <view wx:else class="service-list">
            <view wx:for="{{services}}" wx:key="id" class="service-card {{item.selected ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="onService">
              <view class="check"><view wx:if="{{item.selected}}" class="tick"></view></view>
              <view class="service-main">
                <text class="service-name">{{item.name}}</text>
                <text class="service-desc">{{item.desc}}</text>
                <text class="service-price">{{item.priceText}}</text>
                <text class="pill">{{item.warranty}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="panel">
        <view class="section-toggle" data-key="brand" bindtap="togglePanel">
          <text class="section-title">品牌</text>
          <text class="section-meta">{{brandCount}}</text>
          <view class="chevron {{collapsed.brand ? 'is-collapsed' : ''}}"></view>
        </view>
        <view hidden="{{collapsed.brand}}" class="brand-grid">
          <view wx:for="{{brands}}" wx:key="id" class="brand-card {{item.active ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="onBrand">
            <image class="brand-image" src="{{item.image}}" mode="aspectFit" />
            <text class="brand-name">{{item.name}}</text>
            <text class="brand-factor">{{item.priceLabel}}</text>
          </view>
        </view>
      </view>

      <view class="panel">
        <view class="section-toggle" data-key="extra" bindtap="togglePanel">
          <text class="section-title">特殊费用</text>
          <text class="section-meta">按现场勾选</text>
          <view class="chevron {{collapsed.extra ? 'is-collapsed' : ''}}"></view>
        </view>
        <view hidden="{{collapsed.extra}}" class="extra-list">
          <view wx:for="{{extras}}" wx:key="id" class="extra-item {{item.on ? 'is-on' : ''}}">
            <view class="extra-copy">
              <text class="extra-name">{{item.name}}</text>
              <text class="extra-price">{{item.priceLabel}}</text>
            </view>
            <switch checked="{{item.on}}" color="#4263FF" data-id="{{item.id}}" bindchange="onExtra" />
          </view>
        </view>
      </view>

      <view class="panel">
        <view class="section-toggle" data-key="warranty" bindtap="togglePanel">
          <text class="section-title">保修设置</text>
          <text class="section-meta">{{warrantySummary}}</text>
          <view class="chevron {{collapsed.warranty ? 'is-collapsed' : ''}}"></view>
        </view>
        <view hidden="{{collapsed.warranty}}" class="warranty-options">
          <view wx:for="{{warrantyOptions}}" wx:key="days" class="warranty-option {{item.active ? 'is-active' : ''}}" data-days="{{item.days}}" bindtap="onWarranty">{{item.label}}</view>
        </view>
      </view>

      <view class="quote-card">
        <view class="section-toggle" data-key="quote" bindtap="togglePanel">
          <text class="section-title">当前报价单</text>
          <text class="section-meta">同页实时更新</text>
          <view class="chevron {{collapsed.quote ? 'is-collapsed' : ''}}"></view>
        </view>
        <view hidden="{{collapsed.quote}}">
          <view class="quote-head">
            <view>
              <text class="quote-kicker">客户确认报价</text>
              <text class="quote-name">{{quoteName}}</text>
            </view>
            <image wx:if="{{categoryImage}}" class="quote-thumb" src="{{categoryImage}}" mode="aspectFit" />
          </view>
          <view class="quote-brand">
            <image wx:if="{{brandImage}}" class="quote-logo" src="{{brandImage}}" mode="aspectFit" />
            <view>
              <text class="quote-brand-name">{{quoteBrand}}</text>
              <text class="muted">{{quoteCity}}</text>
            </view>
          </view>
          <view class="price-total">
            <text>合计</text>
            <text class="price-total-value">{{quoteTotal}}</text>
          </view>
          <view class="breakdown">
            <text wx:if="{{quoteStatus}}" class="muted">{{quoteStatus}}</text>
            <view wx:for="{{rows}}" wx:key="label" class="breakdown-row">
              <text class="breakdown-label">{{item.label}}</text>
              <text class="breakdown-amount">{{item.amount}}</text>
            </view>
          </view>
          <view class="quote-meta">
            <view class="meta-row"><text class="muted">包含内容</text><text>{{includes}}</text></view>
            <view class="meta-row"><text class="muted">不含/另计</text><text>{{excludes}}</text></view>
            <view class="meta-row"><text class="muted">质保</text><text>{{quoteWarranty}}</text></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="dock">
    <view class="dock-copy">
      <text class="dock-label">当前预估合计</text>
      <text class="dock-amount">{{dockTotal}}</text>
    </view>
    <button class="primary dock-button" disabled="{{!quoteReady}}" bindtap="onConfirm">{{confirmText}}</button>
  </view>
</view>
