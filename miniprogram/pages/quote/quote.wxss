.quote-page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(160deg, #eaf6ff 0%, #e8e5ff 42%, #f4f4fa 78%);
  box-sizing: border-box;
}

.quote-page .dock {
  flex-shrink: 0;
}

.quote-page .scroll {
  flex: 1 1 auto;
  height: 60vh;
  min-height: 240px;
}

.quote-page .status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 38rpx;
}

.quote-page .status-text {
  flex: 1;
  color: #71809b;
  font-size: 21rpx;
  line-height: 1.5;
}

.quote-page .refresh {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #5365ce;
  font-size: 22rpx;
}

.quote-page .sheet {
  background: #fff;
  border-radius: 58rpx 58rpx 0 0;
  padding: 36rpx 38rpx 24rpx;
  min-height: 100%;
}

.quote-page .search {
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #f4f5fa;
}

.quote-page .search-icon {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #8b97b3;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.quote-page .search-icon::after {
  content: "";
  position: absolute;
  width: 10rpx;
  height: 3rpx;
  background: #8b97b3;
  right: -8rpx;
  bottom: -2rpx;
  transform: rotate(40deg);
}

.quote-page .search-input {
  flex: 1;
  height: 88rpx;
  font-size: 24rpx;
}

.quote-page .group-tabs {
  display: flex;
  padding: 8rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: #f2f3f9;
}

.quote-page .group-tab {
  flex: 1;
  min-height: 92rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #65708e;
}

.quote-page .group-tab.is-active {
  color: #4258d7;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(88, 102, 160, 0.1);
}

.quote-page .group-name { font-size: 22rpx; font-weight: 650; }

.quote-page .group-count { font-size: 20rpx; margin-top: 4rpx; }

.quote-page .category-grid,
.quote-page .brand-grid,
.quote-page .service-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.quote-page .category-card,
.quote-page .brand-card {
  width: 31.5%;
  margin-bottom: 16rpx;
  min-height: 180rpx;
  padding: 16rpx 8rpx;
  border-radius: 36rpx;
  border: 2rpx solid #fff;
  background: #f5f5fb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.quote-page .category-card.is-active,
.quote-page .brand-card.is-active,
.quote-page .service-card.is-active,
.quote-page .extra-item.is-on {
  background: linear-gradient(135deg, #edf5ff, #eeeaff);
  border-color: #a5b4ff;
}

.quote-page .category-image { width: 120rpx; height: 84rpx; }

.quote-page .category-name,
.quote-page .brand-name { margin-top: 6rpx; font-size: 22rpx; font-weight: 650; text-align: center; }

.quote-page .category-count,
.quote-page .brand-factor { font-size: 20rpx; color: #777f96; text-align: center; }

.quote-page .brand-image { width: 140rpx; height: 64rpx; }

.quote-page .service-card {
  width: 48.5%;
  margin-bottom: 16rpx;
  padding: 24rpx 18rpx;
  border-radius: 36rpx;
  border: 2rpx solid #fff;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(88, 102, 160, 0.06);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  box-sizing: border-box;
}

.quote-page .check {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border: 3rpx solid #cbd3e8;
  border-radius: 12rpx;
  background: #f7f9fd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quote-page .service-card.is-active .check {
  border-color: #5674f7;
  background: linear-gradient(145deg, #4196ff, #615df3);
}

.quote-page .tick {
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.quote-page .service-main { flex: 1; min-width: 0; }

.quote-page .service-name { display: block; font-size: 26rpx; font-weight: 650; line-height: 1.45; }

.quote-page .service-desc {
  display: block;
  margin-top: 8rpx;
  color: #777f96;
  font-size: 21rpx;
  line-height: 1.5;
}

.quote-page .service-price { display: block; margin-top: 8rpx; color: #405ce2; font-size: 28rpx; font-weight: 700; }

.quote-page .extra-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 108rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 28rpx;
  border: 2rpx solid #fff;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(88, 102, 160, 0.05);
}

.quote-page .extra-name { display: block; font-size: 26rpx; font-weight: 650; }

.quote-page .extra-price { display: block; margin-top: 4rpx; color: #777f96; font-size: 22rpx; }

.quote-page .warranty-options { display: flex; }

.quote-page .warranty-option {
  flex: 1;
  min-height: 76rpx;
  margin-right: 10rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #fff;
  color: #253352;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(88, 102, 160, 0.05);
}

.quote-page .warranty-option:last-child { margin-right: 0; }

.quote-page .warranty-option.is-active {
  color: #fff;
  background: linear-gradient(120deg, #348aff, #645bff);
  border-color: #96adff;
}

.quote-page .quote-card {
  margin-top: 12rpx;
  padding: 8rpx 8rpx 20rpx;
}

.quote-page .quote-head,
.quote-page .quote-brand,
.quote-page .breakdown,
.quote-page .quote-meta {
  background: #fff;
}

.quote-page .quote-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(120deg, #eef5ff, #eeebff);
}

.quote-page .quote-kicker { display: block; color: #7884a3; font-size: 21rpx; }

.quote-page .quote-name { display: block; margin-top: 8rpx; font-size: 32rpx; font-weight: 750; line-height: 1.45; }

.quote-page .quote-thumb { width: 132rpx; height: 100rpx; flex-shrink: 0; }

.quote-page .quote-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.quote-page .quote-logo { width: 140rpx; height: 64rpx; }

.quote-page .quote-brand-name { display: block; font-size: 28rpx; font-weight: 650; }

.quote-page .price-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 18rpx;
}

.quote-page .price-total-value { color: #405ce2; font-size: 48rpx; font-weight: 750; }

.quote-page .breakdown { margin-top: 12rpx; padding: 8rpx 0; }

.quote-page .breakdown-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
}

.quote-page .breakdown-label { flex: 1; color: #4d5874; font-size: 24rpx; }

.quote-page .breakdown-amount { color: #253352; font-weight: 650; }

.quote-page .quote-meta { margin-top: 8rpx; }

.quote-page .meta-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
}

.quote-page .empty { padding: 24rpx 0 12rpx; color: #777f96; font-size: 24rpx; }

.quote-page .dock {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 18rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eeedf7;
  box-shadow: 0 -8rpx 28rpx rgba(87, 100, 153, 0.05);
}

.quote-page .dock-copy { min-width: 180rpx; }

.quote-page .dock-label { display: block; color: #7c87a2; font-size: 20rpx; }

.quote-page .dock-amount { display: block; color: #405ce2; font-size: 44rpx; font-weight: 750; }

.quote-page .dock-button { flex: 1; }

.quote-page { background: #f5f7fb; color: #202a40; }

.quote-page .scroll { min-height: 0; }

.quote-page .banner-wrap { margin: 18rpx 38rpx 28rpx; }

.quote-page .banner-swiper { height: 258rpx; }

.quote-page .quote-banner { height: 258rpx; padding: 32rpx; border-radius: 30rpx; box-sizing: border-box; color: #fff; }

.quote-page .banner-blue { background: linear-gradient(115deg, #304ee1, #4263ff, #6852dd); }

.quote-page .banner-top { display: flex; justify-content: space-between; align-items: center; font-size: 22rpx; color: #dce3ff; }

.quote-page .banner-city { padding: 8rpx 0 8rpx 16rpx; }

.quote-page .banner-title { display: block; font-size: 43rpx; font-weight: 700; margin-top: 24rpx; }

.quote-page .banner-subtitle { display: block; font-size: 22rpx; margin-top: 12rpx; }

.quote-page .sheet { background: transparent; border-radius: 0; padding-top: 0; min-height: 0; }

.quote-page .search { background: #fff; border: 1rpx solid #e9edf3; border-radius: 24rpx; }

.quote-page .panel { margin-top: 28rpx; }

.quote-page .section-title { font-size: 30rpx; }

.quote-page .service-list { display: block; }

.quote-page .service-card { width: 100%; align-items: center; border: 2rpx solid #e9edf3; border-radius: 24rpx; padding: 24rpx; box-shadow: none; }

.quote-page .service-card.is-active { background: #f0f3ff; border-color: #a6b5ff; }

.quote-page .service-price { flex-shrink: 0; font-size: 30rpx; margin: 0 0 0 12rpx; color: #202a40; }

.quote-page .service-hint { font-size: 22rpx; color: #798397; }

.quote-page .category-card,
.quote-page .brand-card { border-radius: 22rpx; box-shadow: none; }

.quote-page .brand-card { min-height: 100rpx; background: #fff; }

.quote-page .brand-image { display: none; }

.quote-page .warranty-options { flex-wrap: wrap; }

.quote-page .warranty-option { flex: none; width: 30%; margin: 0 2% 16rpx 0; border-radius: 16rpx; box-sizing: border-box; border-color: #e9edf3; box-shadow: none; }

.quote-page .warranty-option.no-warranty { background: #f7f1e9; color: #947047; border-color: #ead8bf; }

.quote-page .warranty-option.is-active { background: #eef2ff; color: #4263ff; border-color: #a6b5ff; }

.quote-page .warranty-option.no-warranty.is-active { border-color: #bc894b; color: #815727; }

.quote-page .quote-card { background: #fff; padding: 24rpx; border-radius: 30rpx; border-top: 6rpx solid #4263ff; }

.quote-page .quote-head { background: transparent; padding: 16rpx 0; }

.quote-page .quote-thumb,
.quote-page .quote-logo { display: none; }

.quote-page .quote-name { font-size: 28rpx; }

.quote-page .quote-brand-name { font-size: 24rpx; }

.quote-page .meta-row { line-height: 1.6; }

.quote-page .dock { box-shadow: none; }

.quote-page .dock-button { border-radius: 20rpx; background: #4263ff; }

.quote-page .config-card { padding: 0 24rpx 16rpx; margin: 32rpx 0; background: #fff; border: 2rpx solid #e9edf3; border-radius: 32rpx; }
.quote-page .config-card .panel { margin-top: 0; }
.quote-page .config-card .extra-item { border: 0; border-bottom: 2rpx solid #e9edf3; border-radius: 0; box-shadow: none; padding: 18rpx 0; margin: 0; }
.quote-page .config-card .brand-card { border: 2rpx solid #e9edf3; }
.quote-page .config-card .brand-card.is-active { border-color: #a6b5ff; background: #eef2ff; }
.quote-page .price-total { border-top: 2rpx dashed #e0e6f3; padding-top: 24rpx; margin-top: 24rpx; }
.quote-page .quote-meta { line-height: 1.6; }
.quote-page .section-meta { font-size: 22rpx; }
.quote-page .category-count, .quote-page .brand-factor, .quote-page .group-count, .quote-page .status-text, .quote-page .dock-label { font-size: 22rpx; }
