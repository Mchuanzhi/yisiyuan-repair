.page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 38rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding: 28rpx 38rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(165deg, #eef6ff, #f5f5fa 60%);
}

.paper {
  padding: 32rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(72, 80, 151, 0.08);
}

.paper-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.brand { display: block; color: #777f96; font-size: 22rpx; }
.paper-title { display: block; margin-top: 8rpx; font-size: 40rpx; font-weight: 750; }

.stamp {
  width: 132rpx;
  height: 132rpx;
  border: 6rpx solid #d45868;
  border-radius: 50%;
  color: #d45868;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(-12deg);
  font-size: 20rpx;
}

.stamp-strong { font-size: 26rpx; font-weight: 750; }

.info, .lines { margin-top: 12rpx; }
.info-row, .note, .total {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.muted { color: #777f96; }
.total { margin-top: 8rpx; }
.total-value { color: #405ce2; font-size: 40rpx; font-weight: 750; }
.note { align-items: flex-start; }
.sign-block { margin-top: 16rpx; }
.sign-image {
  width: 100%;
  height: 180rpx;
  margin-top: 8rpx;
  background: #f7f8fe;
  border-radius: 20rpx;
}
.claim { display: block; margin-top: 20rpx; color: #5365c3; font-size: 24rpx; line-height: 1.7; }
.voided { display: block; margin-top: 12rpx; color: #d45868; }

.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.actions .primary, .actions .secondary { flex: 1; }
.empty { padding: 40rpx 0; color: #777f96; }
.back { margin-top: 24rpx; }
