.page {
  height: 100vh;
  min-height: 100vh;
  background: linear-gradient(165deg, #eef6ff, #f2efff 30%, #f5f5fa 68%);
}

.sheet {
  height: 100vh;
  padding: 28rpx 38rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding: 28rpx 38rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(72, 80, 151, 0.08);
}

.summary-name { display: block; font-size: 30rpx; font-weight: 750; line-height: 1.45; }
.summary-sub { display: block; margin-top: 8rpx; color: #777f96; font-size: 22rpx; }
.summary-total { color: #405ce2; font-size: 44rpx; font-weight: 750; flex-shrink: 0; }

.pad {
  width: 100%;
  height: 420rpx;
  margin-top: 24rpx;
  background: #fff;
  border: 2rpx solid #b4c4fa;
  border-radius: 36rpx;
}

.field { margin-top: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: #777f96; font-size: 24rpx; }
.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #e8eaf4;
  background: #f7f8fe;
}

.hint { display: block; margin: 20rpx 0 28rpx; color: #777f96; font-size: 24rpx; line-height: 1.6; }
.hint.is-error { color: #d45868; }

.actions { display: flex; gap: 16rpx; }
.actions .secondary,
.actions .primary { flex: 1; }
