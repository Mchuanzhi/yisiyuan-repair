.history-page { background: #f5f7fb; color: #202a40; }
.history-page .scroll { padding: 38rpx; box-sizing: border-box; }
.history-page .intro, .history-page .row { display: flex; align-items: center; justify-content: space-between; }
.history-page .title { display: block; font-size: 44rpx; font-weight: 700; margin-top: 14rpx; }
.history-page .muted { color: #798397; font-size: 24rpx; }
.history-page .count { color: #798397; background: #e9edf5; border-radius: 16rpx; padding: 12rpx; font-size: 24rpx; }
.history-page .stats { display: flex; padding: 36rpx; margin: 36rpx 0 28rpx; background: #eaf0ff; border-radius: 32rpx; }
.history-page .stats > view { flex: 1; }
.history-page .stat-count { border-left: 2rpx solid #d5def9; padding-left: 32rpx; }
.history-page .stat-value { display: block; margin-top: 12rpx; font-size: 44rpx; font-weight: 700; }
.history-page .search { background: #fff; border: 2rpx solid #e9edf3; border-radius: 24rpx; padding: 20rpx 24rpx; font-size: 24rpx; height: 44rpx; }
.history-page .filters { display: flex; margin: 20rpx 0 32rpx; border-bottom: 2rpx solid #e9edf3; }
.history-page .filter { flex: 1; text-align: center; padding: 22rpx 0; font-size: 26rpx; color: #798397; border-bottom: 4rpx solid transparent; }
.history-page .filter.selected { color: #4263ff; border-bottom-color: #4263ff; font-weight: 700; }
.history-page .record { margin-bottom: 24rpx; padding: 30rpx; background: #fff; border: 2rpx solid #e9edf3; border-radius: 32rpx; }
.history-page .name { font-size: 32rpx; font-weight: 700; }
.history-page .badge { padding: 8rpx 14rpx; border-radius: 10rpx; font-size: 23rpx; background: #eff2f6; color: #798397; }
.history-page .badge.active { color: #16866a; background: #e6f5ef; }
.history-page .badge.none { color: #947047; background: #f7f1e9; }
.history-page .device-row { margin: 28rpx 0; }
.history-page .device-copy { flex: 1; min-width: 0; padding-right: 14rpx; }
.history-page .device { font-size: 26rpx; font-weight: 700; }
.history-page .service { display: block; color: #798397; font-size: 24rpx; margin-top: 10rpx; }
.history-page .amount { font-size: 34rpx; font-weight: 700; flex-shrink: 0; }
.history-page .meta { font-size: 21rpx; color: #8c96a8; flex-wrap: wrap; }
.history-page .foot { border-top: 2rpx solid #e9edf3; margin-top: 22rpx; padding-top: 22rpx; font-size: 24rpx; color: #798397; }
.history-page .link { color: #4263ff; }
.history-page .empty { text-align: center; padding: 64rpx 0; color: #798397; }
.history-page .login { margin-top: 24rpx; }
.history-page .end-note { display: block; text-align: center; color: #8c96a8; font-size: 22rpx; padding: 28rpx 0 48rpx; }
