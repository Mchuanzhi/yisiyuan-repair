<scroll-view class="page account-page" style="height: {{pageHeight}}px; min-height: {{pageHeight}}px;" scroll-y>
  <view class="profile" bindtap="onProfileTap" bindlongpress="onProfileLongPress">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-copy"><text class="profile-name">{{profileName}}</text><text class="muted">{{profileStatus}}</text><text wx:if="{{loggedIn}}" class="online">● 已登录</text></view>
  </view>

  <view class="permission-card">
    <text class="permission-label">开具收据权限</text>
    <text class="permission">{{permission}}</text>
    <text class="permission-help">{{canIssue ? '报价确认后，支持客户签名并生成电子收据。' : '开据权限由管理员统一管理。'}}</text>
    <text wx:if="{{canIssue}}" class="verified">已授权 ✓</text>
  </view>
  <view wx:if="{{loggedIn}}">
    <text class="section-title">账号信息</text>
    <view class="card account-list">
      <view class="info-row"><text>账号角色</text><text class="info-value">{{profileStatus}}</text></view>
      <view class="info-row"><text>登录手机号</text><text class="info-value">{{maskedMobile}}</text></view>
      <view class="info-row"><text>微信绑定</text><text class="info-value {{wechatBound ? 'online' : ''}}">{{wechatBound ? '已绑定 ✓' : '未绑定'}}</text></view>
      <view class="info-row"><text>所属服务</text><text class="info-value">壹思源维修</text></view>
    </view>
    <text class="wechat-tip">{{wechatBound ? '已绑定微信，下次打开可快捷登录。' : '可通过微信登录绑定已有师傅账号。'}} 开据权限由管理员统一管理。</text>
    <text class="section-title">服务记录</text>
    <view class="card history-link" bindtap="openHistory"><view><text class="card-title">我开具的收据</text><text class="muted">查看客户签名与维修明细</text></view><text>›</text></view>
  </view>

  <view class="card" hidden="{{loggedIn}}">
    <text class="card-title">师傅登录</text>
    <text class="muted">首次使用请用已有手机号和密码绑定微信。之后优先微信登录。微信登录不会自动开通开据权限。</text>
    <button wx:if="{{!useMock}}" class="secondary wechat-login" disabled="{{loggingIn}}" bindtap="onWechat">微信登录</button>
    <text class="label">手机号</text>
    <input class="input" type="number" maxlength="11" value="{{mobile}}" bindinput="onMobile" />
    <text class="label">密码</text>
    <input class="input" password value="{{password}}" bindinput="onPassword" />
    <button class="primary" disabled="{{loggingIn}}" bindtap="onLogin">{{loginLabel}}</button>
  </view>

  <button wx:if="{{loggedIn}}" class="secondary logout" bindtap="onLogout">退出登录</button>
  <text wx:if="{{loggedIn}}" class="end-note">退出后仍可查价，开据时需重新登录</text>

  <view hidden="{{!showDebug}}">
  <view class="card">
    <text class="card-title">报价接口</text>
    <text class="muted">指向正在运行的 local-backend。开发者工具需关闭合法域名校验；本工程 project.config.json 已设置 urlCheck 为 false。</text>
    <text class="label">接口根地址</text>
    <input class="input" value="{{apiBase}}" placeholder="http://127.0.0.1:8787" bindinput="onBase" />
    <view class="mock-row">
      <view>
        <text class="mock-title">本地演示数据</text>
        <text class="muted">不请求后端，用与种子数据相同的目录和计价。</text>
      </view>
      <switch checked="{{useMock}}" color="#4263FF" bindchange="onMock" />
    </view>
    <view class="row">
      <button class="secondary" bindtap="onSave">保存</button>
      <button class="primary" bindtap="onTest">测试连接</button>
    </view>
  </view>

  <view class="card">
    <text class="card-title">演示账号</text>
    <text class="muted">师傅 18800000002 / 123456</text>
    <text class="muted">管理员 18800000001 / 123456</text>
    <text class="muted">正式接口里，张师傅默认不能开据。请管理员在后台「权限设置」开通后再生成收据。打开本地演示数据时，张师傅可以直接走通签名和收据。</text>
  </view>
  </view>
  <text class="message">{{message}}</text>
  <view class="brand-footer"><text>壹思源维修</text><text class="muted">透明报价 · 安心维修</text></view>
</scroll-view>
