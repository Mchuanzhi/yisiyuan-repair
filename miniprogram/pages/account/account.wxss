.page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 38rpx calc(36rpx + constant(safe-area-inset-bottom));
  padding: 28rpx 38rpx calc(36rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eaf6ff, #f4f4fa 280rpx);
}

.profile { padding: 24rpx 0 12rpx; text-align: center; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #65ccff, #6b60f6);
  color: #fff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-name { display: block; font-size: 36rpx; font-weight: 750; }
.muted { display: block; margin-top: 8rpx; color: #777f96; font-size: 23rpx; line-height: 1.7; }

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(72, 80, 151, 0.06);
}

.card-title { display: block; font-size: 32rpx; font-weight: 750; }
.permission { display: block; margin-top: 12rpx; color: #4258d7; font-size: 28rpx; }
.label { display: block; margin: 18rpx 0 8rpx; color: #777f96; font-size: 24rpx; }
.input {
  height: 88rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f7f8fe;
  border: 2rpx solid #e8eaf4;
}

.card .primary { margin-top: 24rpx; }
.logout { width: 100%; margin-top: 20rpx; }

.mock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}
.mock-title { display: block; font-size: 28rpx; font-weight: 650; }
.row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.row .primary, .row .secondary { flex: 1; }
.message { display: block; padding: 24rpx 8rpx 12rpx; color: #5365c3; font-size: 26rpx; line-height: 1.7; }
