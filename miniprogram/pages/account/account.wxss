.account-page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 38rpx 36rpx;
  background: linear-gradient(180deg, #eaf6ff, #f4f4fa 280rpx);
}

.account-page .profile { padding: 24rpx 0 12rpx; text-align: center; }

.account-page .avatar {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #65ccff, #6b60f6);
  color: #fff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.account-page .profile-name { display: block; font-size: 36rpx; font-weight: 750; }

.account-page .muted { display: block; margin-top: 8rpx; color: #777f96; font-size: 23rpx; line-height: 1.7; }

.account-page .card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(72, 80, 151, 0.06);
}

.account-page .card-title { display: block; font-size: 32rpx; font-weight: 750; }

.account-page .permission { display: block; margin-top: 12rpx; color: #4258d7; font-size: 28rpx; }

.account-page .label { display: block; margin: 18rpx 0 8rpx; color: #777f96; font-size: 24rpx; }

.account-page .input {
  height: 88rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f7f8fe;
  border: 2rpx solid #e8eaf4;
}

.account-page .card .primary { margin-top: 24rpx; }

.account-page .wechat-login { width: 100%; margin-top: 18rpx; }

.account-page .logout { width: 100%; margin-top: 20rpx; }

.account-page .mock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.account-page .mock-title { display: block; font-size: 28rpx; font-weight: 650; }

.account-page .row { display: flex; gap: 16rpx; margin-top: 20rpx; }

.account-page .row .primary,
.account-page .row .secondary { flex: 1; }

.account-page .message { display: block; padding: 24rpx 8rpx 12rpx; color: #5365c3; font-size: 26rpx; line-height: 1.7; }

.account-page { background: #f5f7fb; color: #202a40; padding: 38rpx; box-sizing: border-box; }
.account-page .profile { display: flex; text-align: left; align-items: center; padding: 24rpx 0 44rpx; }
.account-page .avatar { margin: 0 28rpx 0 0; width: 116rpx; height: 116rpx; border: 8rpx solid #fff; border-radius: 36rpx; color: #4263ff; background: #e5ebff; box-shadow: none; font-size: 52rpx; }
.account-page .profile-copy { flex: 1; }
.account-page .profile-name { font-size: 44rpx; }
.account-page .online { display: block; margin-top: 10rpx; color: #16866a; font-size: 24rpx; }
.account-page .permission-card { position: relative; padding: 38rpx 30rpx; background: #263c83; color: #fff; border-radius: 32rpx; }
.account-page .permission-label { font-size: 23rpx; color: #bdcbf5; }
.account-page .permission { color: #fff; font-size: 30rpx; font-weight: 700; }
.account-page .permission-help { display: block; font-size: 23rpx; color: #bdcbf5; margin-top: 18rpx; line-height: 1.6; }
.account-page .verified { position: absolute; top: -12rpx; right: 24rpx; background: #dff4e9; color: #16866a; padding: 8rpx 16rpx; border-radius: 10rpx; font-size: 22rpx; }
.account-page .section-title { display: block; margin-top: 48rpx; font-size: 32rpx; font-weight: 700; }
.account-page .card { border-radius: 32rpx; border: 2rpx solid #e9edf3; box-shadow: none; }
.account-page .info-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid #e9edf3; color: #798397; font-size: 26rpx; }
.account-page .info-row:last-child { border-bottom: 0; }
.account-page .info-value { color: #202a40; font-weight: 600; text-align: right; }
.account-page .info-value.online { color: #16866a; margin: 0; }
.account-page .wechat-tip { display: block; color: #798397; font-size: 23rpx; margin: 24rpx 12rpx; line-height: 1.8; }
.account-page .history-link { display: flex; align-items: center; justify-content: space-between; }
.account-page .history-link .card-title { font-size: 28rpx; }
.account-page .logout { margin-top: 52rpx; border-radius: 20rpx; background: #fff; border: 2rpx solid #dbe2ef; color: #798397; }
.account-page .end-note { display: block; text-align: center; color: #8c96a8; font-size: 22rpx; margin-top: 24rpx; }
.account-page .brand-footer { padding: 48rpx 0; text-align: center; color: #a6afbf; font-size: 28rpx; font-weight: 600; }
